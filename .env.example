# Public browser origin used for OAuth redirects and same-origin deployment.
APP_ORIGIN=http://127.0.0.1:5173

# GitHub OAuth App values. Never expose the secret in Vite or client code.
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
GITHUB_CALLBACK_URL=http://127.0.0.1:5173/api/auth/github/callback
GITHUB_API_VERSION=2026-03-10

# Local API server port.
PORT=8787