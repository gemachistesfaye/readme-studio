# ==========================================
# README Studio - Environment Configuration
# ==========================================

# 1. Frontend (Vite) API Base URL
# For local development: leave empty or use http://127.0.0.1:8787
# For Vercel production: https://<your-render-backend-url>.onrender.com
VITE_GITHUB_API_BASE_URL=http://127.0.0.1:8787

# 2. Backend (Node.js Server) Origin
# Public browser origin used for OAuth redirects and CORS
# For local development: http://127.0.0.1:5173
# For Render production: https://<your-vercel-domain>.vercel.app
APP_ORIGIN=http://127.0.0.1:5173

# 3. GitHub OAuth App Credentials
# Create at https://github.com/settings/developers
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
GITHUB_CALLBACK_URL=http://127.0.0.1:8787/api/auth/github/callback
GITHUB_API_VERSION=2026-03-10

# 4. Server Port & Host
PORT=8787
HOST=0.0.0.0